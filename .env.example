# Env file for `orchestrate server start --env-file .env`.
# Copy to .env (gitignored) and fill in. Never commit the filled-in file.

# Pull the Developer Edition images from IBM's registry with your entitlement key
# (myibm.ibm.com > Container software library).
WO_DEVELOPER_EDITION_SOURCE=myibm
WO_ENTITLEMENT_KEY=

# Developer Edition refuses to start without a Groq or watsonx.ai credential.
# The airline agent only uses the Anthropic virtual model, so a placeholder is fine.
# To use watsonx.ai instead, remove GROQ_API_KEY and set WATSONX_APIKEY and WATSONX_SPACE_ID.
GROQ_API_KEY=unused-placeholder

# Key behind the virtual model. Not read by the server; scripts/setup_local.sh
# stores it in the anthropic_creds connection.
ANTHROPIC_API_KEY=
